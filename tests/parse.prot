// This is a protobuf file
syntax = "proto3";
/* Welcome to this protobuf file*/
// Package support not available yet
// The next comment is empty

//

// And it should parse just fine
// So should this

/**/

package test.package;
import "tests/otherfile.prot";
option java_package = "com.test.package";
option cc_enable_arenas = true;

message SearchRequest {
  reserved 5, 6, 7 to 10;
  reserved "foo", "bar";
  oneof testOneOf {
    string query = 1;
    int32 page_number = 2;
  }
  repeated int32 result_per_page = 3 [packed = true];
  optional string language = 12;
  enum Rank {
    NEGATIVE = -1;
    NEUTRAL = 0;
    POSITIVE = 1 [deprecated = true];
  }
  enum Corpus {
    UNIVERSAL = 0;
    WEB = 1;
    IMAGES = 2;
    LOCAL = 3;
    NEWS = 4;
    PRODUCTS = 5;
    VIDEO = 6;
  }
  Corpus corpus = 4;
  map<string, int32> page_views = 11;
  message SubMessage {
    reserved "hello", "world";
    string query = 1;
    int32 query_count = 2;
    enum Langs {
      UNIVERSAL = 0;
      NIM = 1;
      C = 2;
      CPP = 3;
      PYTHON = 4;
    }
  }
}

message Second {
  SearchRequest.SubMessage.Langs test = 1;
}

message Test1 {
  int32 a = 1;
}

message Result {
  string url = 1;
  string title = 2;
  repeated string snippets = 3;
}

enum Corpus {
  UNIVERSAL = 0;
  WEB = 1;
  IMAGES = 2;
  LOCAL = 3;
  NEWS = 4;
  PRODUCTS = 5;
  VIDEO = 6;
}

message Double {
  repeated Test1 a = 1;
  Result b = 2;
  Corpus c = 3;
  oneof testOneOf {
    string query = 4;
    int32 page_number = 5;
  }
  map<sint64, Result> results_by_id = 6;
  map < string , Corpus > corpus_by_name = 7;
}
